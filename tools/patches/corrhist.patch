diff --git a/app/src/nnue.h b/app/src/nnue.h
index bf7d97d..3129d00 100644
--- a/app/src/nnue.h
+++ b/app/src/nnue.h
@@ -2,6 +2,7 @@
 
 #include <libchess/Position.h>
 
+#include "eval_corr.h"
 #include "nnue_kernels.h"
 #include "weights.h"
 
@@ -11,11 +12,22 @@ struct Accumulator
     alignas(64) std::array<std::int16_t, HIDDEN_SIZE> vals;
 };
 
+// Feature keys for the correction layer: one over all pawns, one per side
+// over that side's non-pawns (king included). XOR maintained alongside the
+// accumulator; null moves change neither.
+struct CorrKeys
+{
+	uint64_t pawn     { 0 };
+	uint64_t np_white { 0 };
+	uint64_t np_black { 0 };
+};
+
 class Eval
 {
 private:
 	Accumulator white;
 	Accumulator black;
+	CorrKeys    ck;
 
 	Eval();
 
@@ -33,6 +45,24 @@ public:
 	// right away, so callers can batch a whole move's deltas into one sweep.
 	void push_delta(nnue_k::Delta *deltas, int &n, const int piece, const int square, const bool is_white, const bool add) const;
 
+	// Mirror a piece event into the correction keys. XOR is its own inverse,
+	// so add and remove share this path.
+	void corr_event(const int piece, const int square, const bool is_white)
+	{
+		const uint64_t key = eval_corr::psq_key(piece, square);
+
+		if (piece == 0)
+			ck.pawn ^= key;
+		else if (is_white)
+			ck.np_white ^= key;
+		else
+			ck.np_black ^= key;
+	}
+
+	void corr_clear_keys() { ck = CorrKeys { }; }
+
+	const CorrKeys & corr_keys() const { return ck; }
+
 	std::array<std::int16_t, HIDDEN_SIZE> & acc_white() { return white.vals; }
 	std::array<std::int16_t, HIDDEN_SIZE> & acc_black() { return black.vals; }
 };
